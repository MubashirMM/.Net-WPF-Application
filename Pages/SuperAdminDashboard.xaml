<Page x:Class="WpfApp1.Pages.SuperAdminDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1400"
      Title="Super Admin Dashboard - Reports"
      Background="#F5F5F5"
      Loaded="Page_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="10" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="👑 Super Admin Dashboard" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="WelcomeText" FontSize="12" Foreground="#BDC3C7"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📦 Manage Products" Click="ManageProducts_Click" 
                            Background="#3498DB" Foreground="White" BorderThickness="0"
                             Padding="15,8" Margin="5,0"/>
                    <!--<Button Content="👥 Manage Users" Click="ManageUsers_Click" 
                            Background="#9B59B6" Foreground="White" BorderThickness="0"
                             Padding="15,8" Margin="5,0"/>-->
                    <Button Content="🚪 Logout" Click="Logout_Click" 
                            Background="#E74C3C" Foreground="White" BorderThickness="0"
                             Padding="15,8" Margin="10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <!-- Tab 1: Sales Reports -->
            <TabItem Header="📊 Sales Reports" Background="White">
                <Border Background="White" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Report Filters -->
                        <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Date Range:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <DatePicker x:Name="StartDatePicker" Width="120" Margin="0,0,10,0"/>
                                    <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <DatePicker x:Name="EndDatePicker" Width="120"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                                    <Button Content="Today" Click="TodayReport_Click" 
                                            Background="#27AE60" Foreground="White" BorderThickness="0"
                                             Padding="15,8" Margin="0,0,5,0"/>
                                    <Button Content="This Week" Click="WeekReport_Click" 
                                            Background="#3498DB" Foreground="White" BorderThickness="0"
                                             Padding="15,8" Margin="5,0"/>
                                    <Button Content="This Month" Click="MonthReport_Click" 
                                            Background="#9B59B6" Foreground="White" BorderThickness="0"
                                             Padding="15,8" Margin="5,0"/>
                                    <Button Content="All Time" Click="AllTimeReport_Click" 
                                            Background="#E67E22" Foreground="White" BorderThickness="0"
                                             Padding="15,8" Margin="5,0"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="🔍 Generate Report" Click="GenerateReport_Click" 
                                        Background="#2C3E50" Foreground="White" FontWeight="SemiBold"
                                         Padding="20,10" BorderThickness="0"/>
                            </Grid>
                        </Border>

                        <!-- Summary Cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#27AE60" CornerRadius="10" Padding="15" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Total Sales" FontSize="12" Foreground="White" Opacity="0.8"/>
                                    <TextBlock x:Name="TotalSalesText" Text="₱0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="TotalOrdersCount" Text="0 Orders" FontSize="11" Foreground="White" Opacity="0.7"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#3498DB" CornerRadius="10" Padding="15" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Total Items Sold" FontSize="12" Foreground="White" Opacity="0.8"/>
                                    <TextBlock x:Name="TotalItemsSoldText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="UniqueProductsText" Text="0 Products" FontSize="11" Foreground="White" Opacity="0.7"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#9B59B6" CornerRadius="10" Padding="15" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Average Order Value" FontSize="12" Foreground="White" Opacity="0.8"/>
                                    <TextBlock x:Name="AverageOrderText" Text="₱0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Per Transaction" FontSize="11" Foreground="White" Opacity="0.7"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#E74C3C" CornerRadius="10" Padding="15" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="Total Customers" FontSize="12" Foreground="White" Opacity="0.8"/>
                                    <TextBlock x:Name="TotalCustomersText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="NewCustomersText" Text="0 New" FontSize="11" Foreground="White" Opacity="0.7"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Products Sales Grid -->
                        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="📦 Product Sales Report" FontSize="18" FontWeight="Bold" 
                                           Foreground="#2C3E50" Margin="15,10"/>

                                <DataGrid x:Name="SalesReportGrid" Grid.Row="1" AutoGenerateColumns="False" 
                                          Height="400" IsReadOnly="True"
                                          RowBackground="White" AlternatingRowBackground="#F8F9FA"
                                          GridLinesVisibility="Horizontal" BorderBrush="#ECF0F1">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#34495E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Height" Value="35"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Product ID" Binding="{Binding ProductId}" Width="80"/>
                                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="Quantity Sold" Binding="{Binding TotalQuantity}" Width="120"/>
                                        <DataGridTextColumn Header="Total Revenue" Binding="{Binding TotalRevenue, StringFormat={}{0:C2}}" Width="150"/>
                                        <DataGridTextColumn Header="Times Ordered" Binding="{Binding OrderCount}" Width="120"/>
                                        <DataGridTemplateColumn Header="View Details" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="📄 View" Click="ViewProductDetails_Click" 
                                                            Tag="{Binding ProductId}"
                                                            Background="#3498DB" Foreground="White"
                                                            BorderThickness="0" 
                                                            Padding="10,5" FontSize="11"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 2: Order Details -->
            <TabItem Header="📋 All Orders" Background="White">
                <Border Background="White" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📋 Order History - All Customers" FontSize="18" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,15"/>

                        <DataGrid x:Name="AllOrdersGrid" AutoGenerateColumns="False" 
                                  Height="550" IsReadOnly="True"
                                  RowBackground="White" AlternatingRowBackground="#F8F9FA"
                                  GridLinesVisibility="Horizontal" BorderBrush="#ECF0F1">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#34495E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="35"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bill Number" Binding="{Binding BillNumber}" Width="150"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding UserName}" Width="150"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                                <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat={}{0:C2}}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📄 View Bill" Click="ViewOrderBill_Click" 
                                                    Tag="{Binding BillNumber}"
                                                    Background="#27AE60" Foreground="White"
                                                    BorderThickness="0" 
                                                    Padding="10,5" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Tab 3: User List -->
            <TabItem Header="👥 User Management" Background="White">
                <Border Background="White" Padding="20">
                    <StackPanel>
                        <TextBlock Text="👥 Registered Users" FontSize="18" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,15"/>

                        <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" 
                                  Height="550" IsReadOnly="True"
                                  RowBackground="White" AlternatingRowBackground="#F8F9FA"
                                  GridLinesVisibility="Horizontal" BorderBrush="#ECF0F1">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#34495E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="35"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User ID" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="150"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                                <DataGridTextColumn Header="Total Orders" Binding="{Binding OrderCount}" Width="100"/>
                                <DataGridTextColumn Header="Total Spent" Binding="{Binding TotalSpent, StringFormat={}{0:C2}}" Width="120"/>
                                <DataGridTemplateColumn Header="View Orders" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📋 Orders" Click="ViewUserOrders_Click" 
                                                    Tag="{Binding Id}"
                                                    Background="#9B59B6" Foreground="White"
                                                    BorderThickness="0" 
                                                    Padding="10,5" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Page>