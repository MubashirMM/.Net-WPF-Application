<Page x:Class="WpfApp1.Pages.UserDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1400"
      Title="User Dashboard - Shopping"
      Background="#F5F5F5"
      Loaded="Page_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="10" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🛍️ Shopping Center" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="WelcomeText" FontSize="12" Foreground="#BDC3C7"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#E74C3C" CornerRadius="15" Padding="10,5" Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛒 Cart: " Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CartCount" Text="0" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2" Content="🚪 Logout" Click="Logout_Click" 
                        Background="#E74C3C" Foreground="White" BorderThickness="0"
                        Padding="15,8" Margin="10,0"/>
            </Grid>
        </Border>

       
        <TabControl Grid.Row="1">
            <!-- Tab 1: Shopping -->
            <TabItem Header="🛒 Shopping" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="450"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel - Products -->
                    <Border Grid.Column="0" Background="White" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <!-- Search Box -->
                            <Border Background="#F0F0F0" Padding="10" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" Grid.Column="0" Tag="Search products..." 
                                             TextChanged="SearchBox_TextChanged"
                                             FontSize="14" Padding="10"/>
                                    <Button Grid.Column="1" Content="🔍 Search" Click="SearchButton_Click" 
                                            Background="#3498DB" Foreground="White" BorderThickness="0"
                                            Padding="15,8" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Products Grid -->
                            <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" 
                                      Height="550" IsReadOnly="True"
                                      RowBackground="White" AlternatingRowBackground="#F8F9FA"
                                      GridLinesVisibility="Horizontal" BorderBrush="#ECF0F1"
                                      SelectionMode="Single">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#34495E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Height" Value="35"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding ProductPrice, StringFormat={}{0:C2}}" Width="100"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding ProductStock}" Width="80"/>
                                    <DataGridTemplateColumn Header="Action" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🛒 Add to Cart" 
                                                        Click="AddToCart_Click" 
                                                        Background="#27AE60" Foreground="White"
                                                        BorderThickness="0"
                                                        Padding="10,5" FontSize="11"
                                                        Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Right Panel - Shopping Cart -->
                    <Border Grid.Column="1" Background="White" Padding="15" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🛒 Your Shopping Cart" FontSize="20" FontWeight="Bold" 
                                       Foreground="#2C3E50" Margin="0,0,0,15"/>

                            <!-- Cart Items List -->
                            <ScrollViewer Height="350">
                                <ItemsControl x:Name="CartItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#ECF0F1" BorderThickness="0,0,0,1" 
                                                    Padding="5" Margin="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding ProductName}" 
                                                                   FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock Text="{Binding Price, StringFormat={}{0:C2}}" 
                                                                   Foreground="#27AE60" FontSize="12"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                                                VerticalAlignment="Center">
                                                        <Button Content="-" Click="DecreaseQuantity_Click" 
                                                                Tag="{Binding}" Width="30" Height="30"
                                                                Background="#E74C3C" Foreground="White"
                                                                FontWeight="Bold" FontSize="16"
                                                                BorderThickness="0"/>

                                                        <TextBlock Text="{Binding Quantity}" 
                                                                   Width="40" TextAlignment="Center"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   VerticalAlignment="Center"/>

                                                        <Button Content="+" Click="IncreaseQuantity_Click" 
                                                                Tag="{Binding}" Width="30" Height="30"
                                                                Background="#27AE60" Foreground="White"
                                                                FontWeight="Bold" FontSize="16"
                                                                BorderThickness="0"/>

                                                        <Button Content="🗑" Click="RemoveFromCart_Click" 
                                                                Tag="{Binding}" Width="30" Height="30"
                                                                Background="#95A5A6" Foreground="White"
                                                                FontSize="12" BorderThickness="0" 
                                                                Margin="5,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Cart Summary -->
                            <Border Background="#F8F9FA" Padding="15" Margin="0,10">
                                <StackPanel>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total Items:" FontSize="14"/>
                                        <TextBlock x:Name="TotalItemsText" Grid.Column="1" 
                                                   Text="0" FontSize="14" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Subtotal:" FontSize="14"/>
                                        <TextBlock x:Name="SubtotalText" Grid.Column="1" 
                                                   Text="₱0.00" FontSize="14" Foreground="#27AE60"/>
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tax (12%):" FontSize="14"/>
                                        <TextBlock x:Name="TaxText" Grid.Column="1" 
                                                   Text="₱0.00" FontSize="14" Foreground="#F39C12"/>
                                    </Grid>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total:" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock x:Name="TotalText" Grid.Column="1" 
                                                   Text="₱0.00" FontSize="18" FontWeight="Bold" 
                                                   Foreground="#E74C3C"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🗑 Clear Cart" Click="ClearCart_Click" 
                                        Background="#95A5A6" Foreground="White" FontWeight="SemiBold"
                                        Height="40" Margin="0,0,5,0" BorderThickness="0"/>
                                <Button Grid.Column="1" Content="📄 Generate Bill" Click="GenerateBill_Click" 
                                        Background="#27AE60" Foreground="White" FontWeight="SemiBold"
                                        Height="40" Margin="5,0,0,0" BorderThickness="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Order History -->
            <TabItem Header="📜 Order History" Background="White">
                <Border Background="White" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📜 Your Order History" FontSize="22" FontWeight="Bold" 
                                   Foreground="#2C3E50" Margin="0,0,0,20"/>

                        <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" 
                                  Height="500" IsReadOnly="True"
                                  RowBackground="White" AlternatingRowBackground="#F8F9FA"
                                  GridLinesVisibility="Horizontal" BorderBrush="#ECF0F1"
                                  SelectionChanged="OrdersGrid_SelectionChanged">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#34495E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="35"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bill Number" Binding="{Binding BillNumber}" Width="150"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
                                <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat={}{0:C2}}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📄 View PDF" 
                                                    Click="ViewPDF_Click" 
                                                    Tag="{Binding BillNumber}"
                                                    Background="#3498DB" Foreground="White"
                                                    BorderThickness="0"
                                                    Padding="10,5" FontSize="11"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="EmptyHistoryText" 
                                   Text="No orders found. Start shopping to see your order history here!"
                                   FontSize="14" Foreground="#7F8C8D"
                                   HorizontalAlignment="Center" Margin="0,50,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    
    </Grid>
</Page>